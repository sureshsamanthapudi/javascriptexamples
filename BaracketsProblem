function bracketsProblem(str){
    let stack = [];
    for(let char of str){
        console.log("bracketsProblem",char)
        if(char === "(" || char === "{" || char === "["){
           stack.push(char) 
        } else {
            let last = stack.pop()
            if (
                (char === ')' && last !== '(') ||
                (char === '}' && last !== '{') ||
                (char === ']' && last !== '[')
                ) {
                   return false
                }
            
            
        }
    }
    return stack.length === 0
}

const isBracesMatched = bracketsProblem("((()))")
console.log(isBracesMatched  ? "Proper Array" : "Inavlid Array")
