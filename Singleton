var singleton = (function () {
     var instance
    function createInstance(){
        var obj = {title: "Welcome"}
        return obj
    }

  
    return {
        getInstance: function () {
            if (!instance) {
                instance = createInstance();
            }
            return instance;
        }
    };
    
})()

var obj1 = singleton.getInstance();
var obj2 = singleton.getInstance();

console.log(obj1);
console.log(obj1 === obj2); 


